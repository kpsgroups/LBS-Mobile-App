{
  "expo": {
    "name": "LBS Interior Studio",
    "slug": "lbs-interior-studio",
    "scheme": "lbsstudio",
    "version": "0.1.4",
    "orientation": "default",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lbs.interiorstudio"
    },
    "android": {
      "package": "com.lbs.interiorstudio",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 5
    },
    "plugins": [
      "./plugins/withRoomManifest",
      "expo-dev-client",
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": [
              "AR"
            ]
          },
          "ios": {
            "cameraUsagePermission": "Place your wardrobe in the room using the camera."
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a room photo to preview your wardrobe.",
          "microphonePermission": false
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}

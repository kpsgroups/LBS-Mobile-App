{
  "expo": {
    "name": "LBS Interior Studio",
    "slug": "lbs-interior-studio",
    "scheme": "lbsstudio",
    "version": "0.1.0",
    "orientation": "default",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lbs.interiorstudio"
    },
    "android": {
      "package": "com.lbs.interiorstudio",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "./plugins/withRoomManifest",
      "expo-dev-client",
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": ["AR"]
          },
          "ios": {
            "cameraUsagePermission": "Place your wardrobe in the room using the camera."
          }
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
